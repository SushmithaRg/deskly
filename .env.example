# Deskly environment configuration
# Copy this file to `.env` for local development and fill in real values.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# PostgreSQL connection string (required)
# Local example:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/deskly_app?schema=public&sslmode=disable"
# Hosted example (Neon/Supabase/Railway): use the connection string they provide, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT signing secret (generate a strong one, e.g. openssl rand -base64 32)
JWT_SECRET="change-me-to-a-long-random-string"

# Backend port (local dev only; Vercel ignores this)
PORT=5000

# Optional: Gmail SMTP for real email alerts (leave as-is to only log alerts)
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Frontend origin allowed by CORS (set to your Vercel URL in production)
FRONTEND_URL="http://localhost:5173"

# File upload directory (Vercel automatically uses /tmp/uploads)
UPLOAD_DIR="./uploads"
