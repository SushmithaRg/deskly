datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  role             String    @default("EMPLOYEE")
  fullName         String
  employeeId       String    @unique
  photoUrl         String?
  jobTitle         String    @default("Employee")
  department       String    @default("General")
  team             String    @default("General Team")
  managerName      String?
  joiningDate      String    @default("")
  location         String    @default("HQ")
  phone            String    @default("")
  skills           String    @default("[]")
  aboutMe          String    @default("")
  education        String    @default("[]")
  certifications   String    @default("[]")
  experience       String    @default("[]")
  emergencyContact String    @default("")
  status           String    @default("ACTIVE")

  tasks            Task[]    @relation("TaskAssignee")
  createdTasks     Task[]    @relation("TaskCreator")
  leaveRequests    LeaveRequest[]
  documents        Document[]
  okrs             GoalOKR[]
  givenBadges      Recognition[] @relation("BadgeGiver")
  receivedBadges   Recognition[] @relation("BadgeReceiver")
  attendance       Attendance[]
  meetings         MeetingAttendee[]
  hostedMeetings   Meeting[] @relation("MeetingOrganizer")
  notifications    Notification[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("On Track")
  progress    Int      @default(0)
  dueDate     String
  ownerId     String?
  department  String   @default("Engineering")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("TODO")
  priority    String   @default("MEDIUM")
  projectName String?
  assigneeId  String
  assignee    User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  dueDate     String
  progress    Int      @default(0)
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRequest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  startDate    String
  endDate      String
  daysCount    Int
  reason       String
  status       String   @default("PENDING")
  approvedBy   String?
  createdAt    DateTime @default(now())
}

model Document {
  id             String   @id @default(uuid())
  title          String
  category       String
  fileUrl        String
  fileSize       String
  fileType       String
  isConfidential Boolean  @default(false)
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model GoalOKR {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String
  target    Int      @default(100)
  current   Int      @default(0)
  quarter   String
  year      Int
  unit      String   @default("units")
  createdAt DateTime @default(now())
}

model Recognition {
  id         String   @id @default(uuid())
  giverId    String
  giver      User     @relation("BadgeGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("BadgeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  badgeType  String
  message    String
  createdAt  DateTime @default(now())
}

model Attendance {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  checkIn    String
  checkOut   String?
  totalHours Float?
  location   String   @default("Office")
  status     String   @default("Present")
  createdAt  DateTime @default(now())
}

model Meeting {
  id            String   @id @default(uuid())
  title         String
  date          String
  startTime     String
  endTime       String
  locationOrLink String
  organizerId   String
  organizer     User     @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  category      String   @default("Sync")
  description   String?
  attendees     MeetingAttendee[]
  createdAt     DateTime @default(now())
}

model MeetingAttendee {
  id        String  @id @default(uuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    String
  target    String   @default("ALL")
  tag       String   @default("General")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
}
